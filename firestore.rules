rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === COMMON FUNCTIONS ===

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    function signedIn() {
      return request.auth != null;
    }

    // Check if user is an admin
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ATP Owners functions
    function isOwner() {
      return isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    function isCreatingOwnRecord() {
      return isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
    }

    // === ORIGINAL APP RULES ===

    // Flight Logs Rules
    match /flightLogs/{flightId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // Units Rules
    match /units/{unitId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Malfunction Types Rules
    match /malfunctionTypes/{typeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Malfunction Severities Rules
    match /malfunctionSeverities/{sevId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Admins Collection Rules
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only manageable via Firebase Console for security
    }

    // === ATP SUFA RULES ===
    
    match /systemTypes/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /testDefinitions/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /tests/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /atpRecords/{docId} {
      allow create: if isCreatingOwnRecord() || isAdmin();
      allow read: if isAdmin() || isOwner();
      allow update: if isAdmin() || (isOwner() && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin() || isOwner();
    }
  }
}
